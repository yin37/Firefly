---
// 站内账号组件：导航栏账号按钮 + 登录/注册弹窗（不跳转页面）
// - 未登录：点按钮弹出 登录/注册 双 Tab 弹窗
// - 已登录：弹窗显示身份信息 + 退出登录
// - 监听全局事件 open-auth-modal，供「私人书架门禁」等处直接拉起弹窗
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";
---

<button
	aria-label="账号"
	aria-controls="auth-overlay"
	aria-expanded="false"
	class="btn-plain scale-animation rounded-lg h-9 w-9 md:h-11 md:w-11 active:scale-90 relative"
	id="auth-switch"
>
	<span id="auth-icon-guest"><Icon name="material-symbols:person-outline-rounded" class="text-[1.25rem]" /></span>
	<span id="auth-icon-user" class="hidden relative">
		<Icon name="material-symbols:person-rounded" class="text-[1.25rem]" />
		<span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-(--primary)"></span>
	</span>
</button>

<!-- 登录/注册弹窗 -->
<div
	id="auth-overlay"
	class="hidden fixed inset-0 flex items-center justify-center p-4"
	style="background: rgba(0,0,0,0.45); backdrop-filter: blur(4px); z-index: 9999;"
>
	<div id="auth-card" class="card-base rounded-2xl w-full max-w-90 p-6 relative">
		<button
			id="auth-close"
			aria-label="关闭"
			class="btn-plain absolute top-3 right-3 rounded-lg h-8 w-8 active:scale-90"
		>
			<Icon name="material-symbols:close-rounded" class="text-[1.1rem]" />
		</button>

		<!-- 未登录：Tab + 两个表单 -->
		<div id="auth-forms">
			<h2 id="auth-title" class="text-lg font-bold text-black/80 dark:text-white/80 mb-4 text-center">
				登录 / 注册
			</h2>
			<div id="auth-tabs" class="flex gap-2 mb-4">
				<button type="button" data-tab="login" class="auth-tab flex-1 py-1.5 rounded-lg text-sm font-medium transition-all bg-(--primary) text-white dark:text-black/70">
					登录
				</button>
				<button type="button" data-tab="register" class="auth-tab flex-1 py-1.5 rounded-lg text-sm font-medium transition-all opacity-60 hover:opacity-90">
					注册
				</button>
			</div>

			<form id="auth-login-form" class="space-y-2">
				<input
					id="auth-login-email" type="email" placeholder="邮箱" autocomplete="email"
					class="w-full px-3 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/10
					       border border-black/8 dark:border-white/8
					       text-black/80 dark:text-white/80 placeholder-black/25 dark:placeholder-white/25
					       outline-hidden focus:border-(--primary) transition"
				/>
				<input
					id="auth-login-password" type="password" placeholder="密码" autocomplete="current-password"
					class="w-full px-3 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/10
					       border border-black/8 dark:border-white/8
					       text-black/80 dark:text-white/80 placeholder-black/25 dark:placeholder-white/25
					       outline-hidden focus:border-(--primary) transition"
				/>
				<p id="auth-login-msg" class="text-xs text-red-500 dark:text-red-400 min-h-4 m-0"></p>
				<button type="submit" id="auth-login-btn"
					class="w-full py-2 rounded-lg text-sm font-medium bg-(--primary) text-white dark:text-black/70 hover:opacity-85 active:scale-[0.98] transition-all">
					登 录
				</button>
			</form>

			<form id="auth-register-form" class="space-y-2 hidden">
				<input
					id="auth-reg-email" type="email" placeholder="邮箱" autocomplete="email"
					class="w-full px-3 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/10
					       border border-black/8 dark:border-white/8
					       text-black/80 dark:text-white/80 placeholder-black/25 dark:placeholder-white/25
					       outline-hidden focus:border-(--primary) transition"
				/>
				<input
					id="auth-reg-password" type="password" placeholder="密码（至少 6 位）" autocomplete="new-password"
					class="w-full px-3 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/10
					       border border-black/8 dark:border-white/8
					       text-black/80 dark:text-white/80 placeholder-black/25 dark:placeholder-white/25
					       outline-hidden focus:border-(--primary) transition"
				/>
				<input
					id="auth-reg-password2" type="password" placeholder="确认密码" autocomplete="new-password"
					class="w-full px-3 py-2 rounded-lg text-sm bg-black/5 dark:bg-white/10
					       border border-black/8 dark:border-white/8
					       text-black/80 dark:text-white/80 placeholder-black/25 dark:placeholder-white/25
					       outline-hidden focus:border-(--primary) transition"
				/>
				<p id="auth-reg-msg" class="text-xs text-red-500 dark:text-red-400 min-h-4 m-0"></p>
				<button type="submit" id="auth-reg-btn"
					class="w-full py-2 rounded-lg text-sm font-medium bg-(--primary) text-white dark:text-black/70 hover:opacity-85 active:scale-[0.98] transition-all">
					注 册
				</button>
			</form>
		</div>

		<!-- 已登录：身份卡片 -->
		<div id="auth-user" class="hidden flex flex-col items-center gap-2 text-center py-2">
			<Icon name="material-symbols:account-circle-rounded" class="text-6xl text-(--primary)" />
			<p id="auth-user-email" class="font-bold text-black/80 dark:text-white/80 m-0 break-all"></p>
			<span id="auth-user-badge" class="rounded-full px-3 py-0.5 text-xs bg-(--btn-regular-bg) opacity-80"></span>
			<a
				id="auth-user-bookshelf"
				href={url("/private/")}
				class="hidden mt-1 text-sm text-(--primary) hover:opacity-80 transition"
			>
				📖 打开私人书架
			</a>
			<button type="button" id="auth-logout"
				class="mt-2 w-full py-2 rounded-lg text-sm font-medium bg-black/5 dark:bg-white/10 text-black/70 dark:text-white/70 hover:opacity-85 active:scale-[0.98] transition-all">
				退出登录
			</button>
		</div>
	</div>
</div>

<style>
	#auth-overlay:not(.hidden) {
		animation: auth-fade-in 0.18s ease-out;
	}
	@keyframes auth-fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	#auth-card {
		animation: auth-pop-in 0.18s ease-out;
	}
	@keyframes auth-pop-in {
		from { transform: scale(0.96) translateY(8px); opacity: 0; }
		to { transform: scale(1) translateY(0); opacity: 1; }
	}
</style>

<script>
	// 全部用 document 级事件委托：Swup 切页替换 DOM 后依然有效，不会出现“点了没反应”
	(function () {
		if (window.__authWidgetInit) return;
		window.__authWidgetInit = true;

		var ME_CACHE = "ff_me_cache";

		function $(id) {
			return document.getElementById(id);
		}
		function clearMeCache() {
			try {
				sessionStorage.removeItem(ME_CACHE);
			} catch (e) {}
		}
		function setLoading(btn, on) {
			if (!btn) return;
			btn.disabled = on;
			btn.style.opacity = on ? "0.5" : "";
		}
		function openModal() {
			var overlay = $("auth-overlay");
			var btn = $("auth-switch");
			if (!overlay) return;
			// 确保弹窗挂在 body 根节点（防层叠上下文问题）
			if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
			overlay.classList.remove("hidden");
			if (btn) btn.setAttribute("aria-expanded", "true");
		}
		function closeModal() {
			var overlay = $("auth-overlay");
			var btn = $("auth-switch");
			if (!overlay) return;
			overlay.classList.add("hidden");
			if (btn) btn.setAttribute("aria-expanded", "false");
		}
		function switchTab(name) {
			var overlay = $("auth-overlay");
			if (!overlay) return;
			overlay.querySelectorAll(".auth-tab").forEach(function (t) {
				var active = t.getAttribute("data-tab") === name;
				t.classList.toggle("bg-(--primary)", active);
				t.classList.toggle("text-white", active);
				t.classList.toggle("dark:text-black/70", active);
				t.classList.toggle("opacity-60", !active);
			});
			var lf = $("auth-login-form");
			var rf = $("auth-register-form");
			if (lf) lf.classList.toggle("hidden", name !== "login");
			if (rf) rf.classList.toggle("hidden", name !== "register");
			var lm = $("auth-login-msg");
			var rm = $("auth-reg-msg");
			if (lm) lm.textContent = "";
			if (rm) rm.textContent = "";
		}
		function showLoggedIn(user) {
			var formsBox = $("auth-forms");
			var userBox = $("auth-user");
			if (formsBox) formsBox.classList.add("hidden");
			if (userBox) {
				userBox.classList.remove("hidden");
				userBox.classList.add("flex");
				var e = $("auth-user-email");
				var b = $("auth-user-badge");
				var bk = $("auth-user-bookshelf");
				if (e) e.textContent = user.email;
				if (b) b.textContent = user.isAdmin ? "管理员" : "普通用户";
				if (bk) bk.classList.toggle("hidden", !user.isAdmin);
			}
			var g = $("auth-icon-guest");
			var u = $("auth-icon-user");
			if (g && u) {
				g.classList.add("hidden");
				u.classList.remove("hidden");
			}
		}

		function handleAuth(kind, body, msgEl, btnEl) {
			setLoading(btnEl, true);
			if (msgEl) msgEl.textContent = "";
			clearMeCache();
			fetch(kind === "login" ? "/api/auth/login" : "/api/auth/register", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(body),
			})
				.then(function (r) {
					return r
						.json()
						.catch(function () {
							throw new Error("BAD_RESPONSE_" + r.status);
						})
						.then(function (d) {
							return { ok: r.ok, status: r.status, d: d };
						});
				})
				.then(function (res) {
					if (res.ok && res.d && res.d.user) {
						// 先写入缓存再刷新，刷新后立刻显示已登录态
						try {
							sessionStorage.setItem(ME_CACHE, JSON.stringify({ user: res.d.user, exp: Date.now() + 600000 }));
						} catch (e) {}
						if (msgEl && msgEl.id === "auth-login-msg") {
							msgEl.textContent = "登录成功，正在进入…";
						}
						location.reload();
						return;
					}
					var code = res.d && res.d.code;
					var text = (res.d && res.d.error) || "操作失败，请重试";
					if (kind === "login" && code === "NO_ACCOUNT") {
						// 账号不存在 → 自动切到注册页签并带入邮箱
						if (msgEl) msgEl.textContent = text;
						var regEmail = $("auth-reg-email");
						if (regEmail) regEmail.value = body.email || "";
						switchTab("register");
						var rp = $("auth-reg-password");
						if (rp) rp.focus();
						return;
					}
					if (kind === "register" && code === "ALREADY_EXISTS") {
						// 已注册 → 自动切回登录页签并带入邮箱
						if (msgEl) msgEl.textContent = text;
						var loginEmail = $("auth-login-email");
						if (loginEmail) loginEmail.value = body.email || "";
						switchTab("login");
						var lp = $("auth-login-password");
						if (lp) lp.focus();
						return;
					}
					if (msgEl) msgEl.textContent = text;
					setLoading(btnEl, false);
				})
				.catch(function (err) {
					if (msgEl) {
						msgEl.textContent =
							err && String(err.message || "").indexOf("BAD_RESPONSE_") === 0
								? "服务器响应异常，请稍后重试"
								: "网络错误，请检查网络后重试";
					}
					console.warn("[auth]", err);
					setLoading(btnEl, false);
				});
		}

		// ---- 事件委托：所有交互在 document 上拦截，元素随时重新查询 ----
		document.addEventListener("click", function (e) {
			var t = e.target;
			if (!t || !t.closest) return;
			if (t.closest("#auth-switch")) {
				var overlay = $("auth-overlay");
				if (overlay && !overlay.classList.contains("hidden")) closeModal();
				else openModal();
				return;
			}
			if (t.closest("#auth-close")) {
				closeModal();
				return;
			}
			var tab = t.closest(".auth-tab");
			if (tab) {
				switchTab(tab.getAttribute("data-tab"));
				return;
			}
			if (t.closest("#auth-logout")) {
				clearMeCache();
				fetch("/api/auth/logout", { method: "POST" }).then(function () {
					location.reload();
				});
				return;
			}
			// 点击遮罩空白处关闭
			var overlay2 = $("auth-overlay");
			var card = $("auth-card");
			if (overlay2 && !overlay2.classList.contains("hidden") && card && !card.contains(t)) {
				closeModal();
			}
		});

		document.addEventListener("submit", function (e) {
			var f = e.target;
			if (!f || !f.id) return;
			if (f.id === "auth-login-form") {
				e.preventDefault();
				handleAuth(
					"login",
					{
						email: ($("auth-login-email") || {}).value ? $("auth-login-email").value.trim() : "",
						password: ($("auth-login-password") || {}).value || "",
					},
					$("auth-login-msg"),
					$("auth-login-btn"),
				);
			}
			if (f.id === "auth-register-form") {
				e.preventDefault();
				var pwd = ($("auth-reg-password") || {}).value || "";
				var pwd2 = ($("auth-reg-password2") || {}).value || "";
				if (pwd !== pwd2) {
					var rm = $("auth-reg-msg");
					if (rm) rm.textContent = "两次输入的密码不一致";
					return;
				}
				handleAuth(
					"register",
					{
						email: ($("auth-reg-email") || {}).value ? $("auth-reg-email").value.trim() : "",
						password: pwd,
					},
					$("auth-reg-msg"),
					$("auth-reg-btn"),
				);
			}
		});

		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape") {
				var overlay = $("auth-overlay");
				if (overlay && !overlay.classList.contains("hidden")) closeModal();
			}
		});

		// 其他组件（私人书架门禁、内容管理门禁）通过该事件拉起弹窗
		document.addEventListener("open-auth-modal", function (e) {
			if (e.detail && e.detail.tab === "register") switchTab("register");
			openModal();
		});

		// 初始化：查会话状态，决定按钮图标（10 分钟缓存，避免每页都请求）
		var cached = null;
		try {
			cached = JSON.parse(sessionStorage.getItem(ME_CACHE));
		} catch (e) {}
		if (cached && cached.exp > Date.now() && typeof cached.user !== "undefined") {
			if (cached.user) showLoggedIn(cached.user);
		} else {
			fetch("/api/auth/me")
				.then(function (r) {
					return r.json();
				})
				.then(function (d) {
					var user = d && d.user ? d.user : null;
					try {
						sessionStorage.setItem(ME_CACHE, JSON.stringify({ user: user, exp: Date.now() + 600000 }));
					} catch (e) {}
					if (user) showLoggedIn(user);
				})
				.catch(function () {});
		}
	})();
</script>
