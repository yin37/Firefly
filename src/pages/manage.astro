---
import MainGridLayout from "@layouts/MainGridLayout.astro";

// 站长内容管理：列出全部文章，已删除（软删除）标红，可恢复或彻底删除
// 增强：状态筛选 / 标题搜索 / 发布日期与分类 / 阅读量热度 / 首页公告管理
---

<MainGridLayout title="内容管理">
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<div class="w-full max-w-[var(--page-width)] mx-auto px-4 flex-1">
		<div class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-6 mb-6">
			<h1 class="text-3xl font-bold mb-2 transition">🗂 内容管理</h1>
			<p class="text-[var(--primary)] opacity-80 text-lg">
				删除的文章全站隐藏并<span class="text-red-500 font-bold">标红显示</span>，可恢复；彻底删除需二次确认
			</p>
			<p class="opacity-60 text-sm mt-1">本页仅站长账号可用。</p>
		</div>

		<!-- 未登录/非管理员提示（默认显示） -->
		<div id="manage-gate" class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-8 text-center">
			<p class="text-lg font-bold mb-2">🔒 站长专属</p>
			<p class="opacity-60 text-sm mb-5">内容管理仅站长账号可用，请先登录。</p>
			<a
				href="/login/?redirect=%2Fmanage%2F"
				id="manage-gate-login"
				class="inline-block rounded-lg bg-(--primary) text-white dark:text-black/70 px-5 py-2 text-sm font-medium hover:opacity-85 transition"
			>
				登录
			</a>
		</div>

		<div id="manage-loading" class="hidden rounded-2xl border border-(--line-divider) bg-(--page-bg) p-8 text-center opacity-60">
			正在读取文章列表…
		</div>

		<!-- 数据仪表盘（管理员可见） -->
		<div id="manage-dash" class="hidden mb-6 flex flex-col gap-3">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
				<div class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-4">
					<div class="text-xs opacity-50 mb-1">👁 总阅读量</div>
					<div id="dash-total" class="text-2xl font-bold text-[var(--primary)]">--</div>
				</div>
				<div class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-4">
					<div class="text-xs opacity-50 mb-1">📅 今日阅读</div>
					<div id="dash-today" class="text-2xl font-bold text-[var(--primary)]">--</div>
					<div id="dash-today-day" class="text-[11px] opacity-40 mt-0.5"></div>
				</div>
				<div class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-4">
					<div class="text-xs opacity-50 mb-1">📝 文章总数</div>
					<div id="dash-posts" class="text-2xl font-bold text-[var(--primary)]">--</div>
					<div id="dash-posts-sub" class="text-[11px] opacity-40 mt-0.5"></div>
				</div>
				<div class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-4 flex flex-col">
					<div class="text-xs opacity-50 mb-1">💾 数据库备份</div>
					<div class="text-[11px] opacity-40 leading-snug mb-2">每天 05:00 自动备份 · 保留 30 天</div>
					<button id="dash-backup-btn" class="mt-auto rounded-lg bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) px-3 py-1.5 text-xs font-medium transition cursor-pointer w-fit">立即备份</button>
					<p id="dash-backup-msg" class="hidden text-[11px] mt-1 leading-snug"></p>
				</div>
			</div>
			<div class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-4">
				<div class="text-sm font-bold mb-2">🔥 热度 Top 10</div>
				<ol id="dash-top" class="flex flex-col gap-1.5 text-sm"></ol>
			</div>
		</div>

		<!-- 工具栏：筛选 + 搜索（管理员可见） -->
		<div id="manage-toolbar" class="hidden flex flex-wrap items-center gap-2 mb-4">
			<div id="manage-tabs" class="flex gap-1.5 flex-wrap">
				<button data-filter="all" class="manage-tab rounded-full px-3.5 py-1.5 text-sm transition cursor-pointer">全部</button>
				<button data-filter="published" class="manage-tab rounded-full px-3.5 py-1.5 text-sm transition cursor-pointer">已发布</button>
				<button data-filter="hidden" class="manage-tab rounded-full px-3.5 py-1.5 text-sm transition cursor-pointer">仅自己可见</button>
				<button data-filter="deleted" class="manage-tab rounded-full px-3.5 py-1.5 text-sm transition cursor-pointer">已删除</button>
			</div>
			<input
				id="manage-search"
				type="search"
				placeholder="搜索标题或路径…"
				class="ml-auto w-56 rounded-lg px-3 py-1.5 text-sm bg-black/5 dark:bg-white/10 text-black/80 dark:text-white/80 outline-none focus:ring-2 ring-(--primary) transition"
			/>
			<span id="manage-count" class="text-xs opacity-50"></span>
		</div>

		<!-- 文章列表（管理员可见） -->
		<div id="manage-list" class="hidden flex flex-col gap-3"></div>

		<!-- 首页公告管理（管理员可见） -->
		<div id="manage-announce" class="hidden rounded-2xl border border-(--line-divider) bg-(--page-bg) p-5 mt-6">
			<h2 class="font-bold text-lg mb-1">📣 首页公告</h2>
			<p class="opacity-50 text-xs mb-3">发布后显示在首页顶部，访客可关闭；留空并保存即撤下。最长 500 字。</p>
			<textarea
				id="announce-text"
				rows="2"
				maxlength="500"
				placeholder="写一句公告，比如：博客改版啦，欢迎留言～"
				class="w-full rounded-lg px-3 py-2 text-sm bg-black/5 dark:bg-white/10 text-black/80 dark:text-white/80 outline-none focus:ring-2 ring-(--primary) transition resize-y"
			></textarea>
			<p id="announce-msg" class="hidden text-xs mt-1"></p>
			<div class="flex gap-2 mt-2">
				<button id="announce-save" class="rounded-lg bg-(--primary) text-white dark:text-black/70 px-4 py-1.5 text-sm font-medium hover:opacity-85 active:scale-[0.98] transition cursor-pointer">发布公告</button>
				<button id="announce-clear" class="rounded-lg bg-black/5 dark:bg-white/10 px-4 py-1.5 text-sm hover:opacity-85 active:scale-[0.98] transition cursor-pointer">撤下公告</button>
			</div>
		</div>

		<div id="manage-error" class="hidden rounded-2xl border border-red-500/40 bg-red-500/10 p-4 text-red-500 text-sm"></div>
	</div>

	<script is:inline>
		(function () {
			var gateBtn = document.getElementById("manage-gate-login");
			if (gateBtn) {
				gateBtn.addEventListener("click", function (e) {
					if (document.getElementById("auth-overlay")) {
						e.preventDefault();
						document.dispatchEvent(new CustomEvent("open-auth-modal"));
					}
				});
			}

			var allPosts = []; // 全量数据
			var viewMap = {}; // slug -> 阅读量
			var curFilter = "all";
			var curSearch = "";

			function showError(msg) {
				var el = document.getElementById("manage-error");
				el.textContent = msg;
				el.classList.remove("hidden");
			}

			function esc(s) {
				return String(s).replace(/[&<>"']/g, function (c) {
					return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
				});
			}

			function statusOf(p) {
				if (p.deleted) return "deleted";
				if (p.hidden) return "hidden";
				return "published";
			}

			function applyFilter() {
				var kw = curSearch.trim().toLowerCase();
				var shown = allPosts.filter(function (p) {
					if (curFilter !== "all" && statusOf(p) !== curFilter) return false;
					if (kw && String(p.title).toLowerCase().indexOf(kw) < 0 && String(p.slug).toLowerCase().indexOf(kw) < 0)
						return false;
					return true;
				});
				document.getElementById("manage-count").textContent =
					"共 " + shown.length + " 篇" + (allPosts.length !== shown.length ? " / 总 " + allPosts.length + " 篇" : "");
				render(shown);
			}

			function render(posts) {
				var list = document.getElementById("manage-list");
				document.getElementById("manage-loading").classList.add("hidden");
				list.classList.remove("hidden");
				list.style.display = "flex";
				if (!posts.length) {
					list.innerHTML = '<div class="opacity-50 text-sm text-center py-8">没有符合条件的文章</div>';
					return;
				}
				list.innerHTML = posts
					.map(function (p) {
						var badges = "";
						if (p.deleted) badges += '<span class="rounded-full bg-red-500/15 text-red-500 dark:text-red-400 px-2.5 py-0.5 text-xs font-bold">已删除（全站隐藏）</span>';
						if (p.hidden) badges += '<span class="rounded-full bg-(--btn-regular-bg) px-2.5 py-0.5 text-xs opacity-70">仅自己可见</span>';
						if (!p.deleted && !p.hidden) badges += '<span class="rounded-full bg-green-500/15 text-green-600 dark:text-green-400 px-2.5 py-0.5 text-xs">已发布</span>';
						var meta = [];
						if (p.published) meta.push(esc(String(p.published).slice(0, 10)));
						if (p.category) meta.push(esc(p.category));
						var views = typeof viewMap[p.slug] === "number" ? viewMap[p.slug] : null;
						meta.push(views === null ? "👁 --" : "👁 " + views);
						var restoreLabel = p.deleted ? "恢复" : "隐藏";
						return (
							'<div class="rounded-2xl border ' +
							(p.deleted ? "border-red-500/50 bg-red-500/5" : "border-(--line-divider) bg-(--page-bg)") +
							' p-4 flex flex-wrap items-center gap-3">' +
							'<div class="flex-1 min-w-[12rem]">' +
							'<div class="font-bold text-lg ' +
							(p.deleted ? "text-red-500 dark:text-red-400 line-through" : "text-[var(--primary)]") +
							'">' +
							esc(p.title) +
							"</div>" +
							'<div class="text-xs opacity-50 mt-0.5">' +
							meta.join(" · ") +
							" · " +
							esc(p.slug) +
							"</div>" +
							"</div>" +
							'<div class="flex gap-2 flex-wrap">' +
							badges +
							"</div>" +
							'<div class="flex gap-2 ml-auto">' +
							'<a href="/admin/#/collections/posts/entries/' +
							encodeURIComponent(p.slug) +
							'" target="_blank" rel="noopener" class="rounded-lg bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) px-3 py-1.5 text-sm transition">编辑</a>' +
							'<button data-act="toggle" data-slug="' +
							esc(p.slug) +
							'" data-deleted="' +
							(p.deleted ? "1" : "0") +
							'" class="rounded-lg px-3 py-1.5 text-sm transition bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) cursor-pointer">' +
							restoreLabel +
							"</button>" +
							'<button data-act="hard-delete" data-slug="' +
							esc(p.slug) +
							'" class="rounded-lg px-3 py-1.5 text-sm transition bg-red-500/10 text-red-500 dark:text-red-400 hover:bg-red-500/20 cursor-pointer">彻底删除</button>' +
							"</div></div>"
						);
					})
					.join("");
			}

			function setRowBusy(slug, busy) {
				document.querySelectorAll('#manage-list button[data-slug="' + CSS.escape(slug) + '"]').forEach(function (b) {
					b.disabled = busy;
					b.style.opacity = busy ? "0.5" : "";
				});
			}

			function api(url, body) {
				return fetch(url, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(body),
				}).then(function (r) {
					return r.json().then(function (d) {
						return { ok: r.ok, d: d };
					});
				});
			}

			// ---- 数据仪表盘 ----
			var titleMap = {}; // slug -> 标题
			function renderDash(stats) {
				document.getElementById("dash-total").textContent = Number(stats.totalViews || 0).toLocaleString();
				document.getElementById("dash-today").textContent = Number(stats.todayViews || 0).toLocaleString();
				document.getElementById("dash-today-day").textContent = stats.today || "";
				document.getElementById("dash-posts").textContent = allPosts.length;
				var pub = allPosts.filter(function (p) { return statusOf(p) === "published"; }).length;
				document.getElementById("dash-posts-sub").textContent = "已发布 " + pub + " 篇";
				var top = (stats.top || []).filter(function (t) { return !titleMap[t.slug] || !isDeletedSlug(t.slug); });
				var max = top.length ? top[0].count : 0;
				document.getElementById("dash-top").innerHTML = top.length
					? top
							.map(function (t, i) {
								var title = titleMap[t.slug] || t.slug;
								var w = max > 0 ? Math.max(4, Math.round((t.count / max) * 100)) : 0;
								return (
									'<li class="flex items-center gap-2">' +
									'<span class="w-5 text-right text-xs font-bold ' + (i < 3 ? "text-(--primary)" : "opacity-40") + '">' + (i + 1) + "</span>" +
									'<a href="/posts/' + encodeURIComponent(t.slug) + '/" class="flex-1 min-w-0 truncate hover:opacity-80 transition">' + esc(title) + "</a>" +
									'<span class="w-24 md:w-40 h-1.5 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden shrink-0"><span class="block h-full rounded-full bg-(--primary)" style="width:' + w + '%"></span></span>' +
									'<span class="w-12 text-right text-xs opacity-60 shrink-0">' + Number(t.count).toLocaleString() + "</span>" +
									"</li>"
								);
							})
							.join("")
					: '<li class="opacity-50 text-xs">暂无阅读数据</li>';
			}
			function isDeletedSlug(slug) {
				var p = allPosts.find(function (x) { return x.slug === slug; });
				return p && p.deleted;
			}
			function fetchStats() {
				fetch("/api/admin/stats")
					.then(function (r) { return r.json(); })
					.then(function (d) {
						if (d && typeof d.totalViews !== "undefined") renderDash(d);
					})
					.catch(function () {});
			}
			var backupBtn = document.getElementById("dash-backup-btn");
			backupBtn.addEventListener("click", function () {
				backupBtn.disabled = true;
				backupBtn.style.opacity = "0.5";
				var msg = document.getElementById("dash-backup-msg");
				msg.classList.remove("hidden");
				msg.textContent = "备份中…";
				fetch("/api/admin/backup", { method: "POST" })
					.then(function (r) { return r.json(); })
					.then(function (d) {
						if (d && d.ok) {
							msg.textContent = "✓ 已备份 " + d.key.replace("backup/", "") + "（" + (d.size / 1024).toFixed(1) + " KB）";
							msg.classList.remove("text-red-500");
						} else {
							msg.textContent = "✗ " + ((d && d.error) || "备份失败");
							msg.classList.add("text-red-500");
						}
					})
					.catch(function () {
						msg.textContent = "✗ 网络错误，请重试";
						msg.classList.add("text-red-500");
					})
					.finally(function () {
						backupBtn.disabled = false;
						backupBtn.style.opacity = "";
					});
			});

			function load() {
				Promise.all([
					fetch("/api/admin/posts").then(function (r) {
						return r.json().then(function (d) {
							return { ok: r.ok, d: d };
						});
					}),
					fetch("/api/admin/views").then(function (r) {
						return r.json().catch(function () {
							return { views: [] };
						});
					}),
				])
					.then(function (res) {
						var postsRes = res[0];
						var viewsRes = res[1];
						if (postsRes.ok && postsRes.d.posts) {
							document.getElementById("manage-gate").classList.add("hidden");
							allPosts = postsRes.d.posts;
							titleMap = {};
							allPosts.forEach(function (p) {
								titleMap[p.slug] = p.title;
							});
							(viewsRes.views || []).forEach(function (v) {
								viewMap[v.slug] = v.count;
							});
							// 热度高的排前面（仅"全部"视图）
							allPosts.sort(function (a, b) {
								return (viewMap[b.slug] || 0) - (viewMap[a.slug] || 0);
							});
							applyFilter();
							fetchStats();
						} else if (postsRes.d && postsRes.d.error === "服务器未配置 GitHub 令牌") {
							document.getElementById("manage-loading").classList.add("hidden");
							showError("⚠️ 服务器尚未配置 GitHub 令牌，隐藏/删除功能不可用。");
						}
						// 403 = 非管理员：保持门禁
					})
					.catch(function () {
						document.getElementById("manage-loading").classList.add("hidden");
						showError("加载失败，请刷新重试。");
					});
			}

			// ---- 工具栏交互 ----
			function paintTabs() {
				document.querySelectorAll(".manage-tab").forEach(function (t) {
					var active = t.getAttribute("data-filter") === curFilter;
					t.classList.toggle("bg-(--primary)", active);
					t.classList.toggle("text-white", active);
					t.classList.toggle("dark:text-black/70", active);
					t.classList.toggle("opacity-60", !active);
				});
			}
			document.getElementById("manage-tabs").addEventListener("click", function (e) {
				var t = e.target && e.target.closest ? e.target.closest(".manage-tab") : null;
				if (!t) return;
				curFilter = t.getAttribute("data-filter");
				paintTabs();
				applyFilter();
			});
			document.getElementById("manage-search").addEventListener("input", function () {
				curSearch = this.value || "";
				applyFilter();
			});

			// ---- 公告管理 ----
			var annText = document.getElementById("announce-text");
			var annMsg = document.getElementById("announce-msg");
			function annShowMsg(t, ok) {
				annMsg.textContent = t;
				annMsg.classList.remove("hidden");
				annMsg.classList.toggle("text-red-500", !ok);
				annMsg.classList.toggle("text-green-600", !!ok);
				annMsg.classList.toggle("dark:text-green-400", !!ok);
				if (t) setTimeout(function () { annMsg.classList.add("hidden"); }, 3000);
			}
			function annSave(clear) {
				var text = clear ? "" : (annText.value || "").trim();
				if (!clear && !text) return annShowMsg("公告内容不能为空", false);
				fetch("/api/admin/announce", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ text: text }),
				})
					.then(function (r) {
						return r.json();
					})
					.then(function (d) {
						if (d && d.ok) annShowMsg(clear ? "公告已撤下 ✓" : "公告已发布 ✓", true);
						else annShowMsg((d && d.error) || "保存失败", false);
					})
					.catch(function () {
						annShowMsg("网络错误，请重试", false);
					});
			}
			document.getElementById("announce-save").addEventListener("click", function () {
				annSave(false);
			});
			document.getElementById("announce-clear").addEventListener("click", function () {
				annSave(true);
			});
			fetch("/api/announce")
				.then(function (r) {
					return r.json();
				})
				.then(function (d) {
					if (d && d.text && annText) annText.value = d.text;
				})
				.catch(function () {});

			document.addEventListener("click", function (e) {
				var btn = e.target && e.target.closest ? e.target.closest("#manage-list button") : null;
				if (!btn) return;
				var slug = btn.getAttribute("data-slug");
				var act = btn.getAttribute("data-act");

				if (act === "toggle") {
					var willDelete = btn.getAttribute("data-deleted") !== "1";
					if (willDelete && !confirm("删除「" + slug + "」？删除后全站不可见，可随时恢复。")) return;
					if (!willDelete && !confirm("恢复「" + slug + "」？恢复后重新出现在网站各列表。")) return;
					setRowBusy(slug, true);
					api("/api/admin/set-deleted", { slug: slug, deleted: willDelete }).then(function (res) {
						if (res.ok) {
							load();
						} else {
							setRowBusy(slug, false);
							alert((res.d && res.d.error) || "操作失败");
						}
					}).catch(function () { setRowBusy(slug, false); alert("网络错误，请重试"); });
				}

				if (act === "hard-delete") {
					// 二次确认：删除后源文件不可恢复
					if (!confirm("⚠️ 彻底删除「" + slug + "」？\n文章源文件将从仓库移除，此操作不可恢复！")) return;
					if (!confirm("【二次确认】真的要彻底删除吗？\n\n· 仅隐藏请点「隐藏」\n· 彻底删除后无法找回\n\n确认请按「确定」")) return;
					setRowBusy(slug, true);
					api("/api/admin/delete-article", { slug: slug }).then(function (res) {
						if (res.ok) {
							alert("已彻底删除，网站将在几分钟内自动更新。");
							load();
						} else {
							setRowBusy(slug, false);
							alert((res.d && res.d.error) || "删除失败");
						}
					}).catch(function () { setRowBusy(slug, false); alert("网络错误，请重试"); });
				}
			});

			fetch("/api/auth/me")
				.then(function (r) {
					return r.json();
				})
				.then(function (d) {
					if (d && d.user && d.user.isAdmin) {
						document.getElementById("manage-gate").classList.add("hidden");
						document.getElementById("manage-dash").classList.remove("hidden");
						document.getElementById("manage-toolbar").classList.remove("hidden");
						document.getElementById("manage-announce").classList.remove("hidden");
						document.getElementById("manage-loading").classList.remove("hidden");
						paintTabs();
						load();
					}
					// 非管理员保持门禁
				})
				.catch(function () {});
		})();
	</script>
