---
import { getSortedPostsIncludingHidden } from "@utils/content-utils";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";

// 仅列出「仅自己可见」(hidden) 的文章；此页面本身没有任何公开入口
const allPosts = await getSortedPostsIncludingHidden();
const hiddenPosts = allPosts
	.filter((p) => p.data.hidden === true)
	.sort(
		(a, b) =>
			new Date(b.data.published).getTime() -
			new Date(a.data.published).getTime(),
	);

function formatDate(d: Date): string {
	const y = d.getFullYear();
	const m = String(d.getMonth() + 1).padStart(2, "0");
	const day = String(d.getDate()).padStart(2, "0");
	return `${y}-${m}-${day}`;
}
---

<MainGridLayout title="私人书架">
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<div class="w-full max-w-[var(--page-width)] mx-auto px-4 flex-1">
		<div class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-6 mb-6">
			<h1 class="text-3xl font-bold mb-2 transition">📖 私人书架</h1>
			<p class="text-[var(--primary)] opacity-80 text-lg">
				仅自己可见的文章清单 · 共 {hiddenPosts.length} 篇
			</p>
			<p class="opacity-60 text-sm mt-1">
				本页仅站长账号登录后可见。
			</p>
		</div>

		<!-- 未登录/非管理员看到的提示（默认显示） -->
		<div id="private-gate" class="rounded-2xl border border-(--line-divider) bg-(--page-bg) p-8 text-center">
			<p class="text-lg font-bold mb-2">🔒 私人内容</p>
			<p class="opacity-60 text-sm mb-5">私人书架仅站长账号可见，请先登录。</p>
			<a
				href="/login/?redirect=%2Fprivate%2F"
				class="inline-block rounded-lg bg-(--primary) text-white dark:text-black/70 px-5 py-2 text-sm font-medium hover:opacity-85 transition"
			>
				登录
			</a>
		</div>

		<!-- 管理员工具条（管理员登录后显示） -->
		<div id="admin-toolbar" class="hidden rounded-2xl border border-(--line-divider) bg-(--page-bg) p-4 mb-4 flex flex-wrap gap-3 items-center text-sm">
			<span class="opacity-60">管理员模式</span>
			<a
				href="/admin/"
				class="rounded-lg bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) px-3 py-1.5 transition"
			>
				✏️ 后台管理文章（编辑 / 显示隐藏 / 删除）
			</a>
			<a href="/login/" class="opacity-50 hover:opacity-90 transition">账号设置</a>
		</div>

		<!-- 文章列表（仅管理员可见；默认隐藏防闪烁） -->
		<div id="private-list" class="hidden">
			<div class="flex flex-col gap-4">
			{hiddenPosts.map((post) => {
				const slug = post.id
					.replace(/\.(md|mdx)$/, "")
					.replace(/\/index$/, "");
				return (
				<a
					href={url(`/private/${slug}/`)}
					class="group rounded-2xl border border-(--line-divider) bg-(--page-bg) p-5 hover:bg-[var(--btn-regular-bg-hover)] transition"
				>
					<div class="flex items-baseline justify-between gap-4 mb-1">
						<h2 class="text-xl font-bold text-[var(--primary)] group-hover:text-[var(--primary)] transition">
							{post.data.title}
						</h2>
						<span class="text-sm opacity-50 shrink-0">
							{formatDate(post.data.published)}
						</span>
					</div>
					{post.data.description && (
						<p class="opacity-60 text-[15px]">{post.data.description}</p>
					)}
					{post.data.tags && post.data.tags.length > 0 && (
						<div class="flex gap-2 mt-2 flex-wrap">
							{post.data.tags.map((tag) => (
								<span class="rounded-full bg-[var(--btn-regular-bg)] px-2.5 py-0.5 text-xs opacity-70">
									{tag}
								</span>
							))}
						</div>
					)}
				</a>
				);
			})}
			</div>
		</div>
	</div>

	<script is:inline>
		(function() {
			fetch('/api/auth/me').then(function(r) { return r.json(); }).then(function(d) {
				var isAdmin = d && d.user && d.user.isAdmin;
				if (isAdmin) {
					document.getElementById('private-gate').classList.add('hidden');
					var list = document.getElementById('private-list');
					list.classList.remove('hidden');
					list.style.display = 'block';
					document.getElementById('admin-toolbar').classList.remove('hidden');
				}
				// 未登录或非管理员：保持门禁提示，列表保持隐藏
			}).catch(function() {});
		})();
	</script>
</MainGridLayout>
