# Cloudflare Workers 静态资源缓存策略
# /_astro/* 是带内容哈希的文件（CSS/JS/字体/优化图片），内容变了文件名必变 → 可安全永久缓存
# HTML 不配置，保持默认 max-age=0 must-revalidate → 每次部署立即生效

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=604800

/pagefind/*
  Cache-Control: public, max-age=86400
